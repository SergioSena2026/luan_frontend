# ============================================================================
# .GITIGNORE - Archivos que Git DEBE IGNORAR y NO subir a GitHub
# ============================================================================
# En un proyecto Node.js hay archivos que no se deben versionar:
# - node_modules: dependencias (se reinstalan con npm install)
# - dist: carpeta de build (se genera automáticamente)
# - .env: variables de entorno con contraseñas (NUNCA se suben)
# - logs: archivos de error temporales
# ============================================================================

# Dependencias
node_modules

# Build de producción
dist
dist-ssr

# Variables de entorno (¡NUNCA subir credenciales!)
.env
.env.local
.env.*.local

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor
.vscode/*
!.vscode/extensions.json
.idea

# Sistema operativo
.DS_Store
Thumbs.db